{
  "name": "obok-staff-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "vars": {
    "ALLOWED_ORIGINS": "https://obokfoods.com,https://www.obokfoods.com,https://obokfood1.github.io"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "obok-shelf-records", "database_id": "REPLACE_WITH_CREATED_DATABASE_ID" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "obok-shelf-photos" }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ANALYSIS_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
  ]
}
