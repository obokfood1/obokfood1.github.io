nt-weight:800}.chips{display:flex;gap:9px;flex-wrap:wrap;margin:20px 0}.chip{background:#fff7ec;border:1px solid #f1d9b8;padding:10px 13px;border-radius:999px;font-weight:800;display:flex;align-items:center;gap:8px}.chip button{padding:0;background:none;color:#b66;font-size:18px}.add-row{display:flex;gap:8px}.add-row input{flex:1;padding:14px 16px;border:1px solid #ddd;border-radius:14px;font-size:16px}.add-row button{background:#312c28;color:#fff}.prefs{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}.prefs label{display:flex;align-items:center;justify-content:space-between;background:#faf7f2;padding:12px 14px;border-radius:14px;font-weight:800}.prefs select{border:0;background:transparent;font-size:15px}.section-head{margin:38px 4px 18px}.section-head p{color:var(--muted)}.recipe-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.recipe{background:#fff;border:1px solid var(--line);border-radius:22px;padding:20px;box-shadow:var(--shadow);cursor:pointer;transition:.2s}.recipe:hover{transform:translateY(-4px)}.recipe .emoji{font-size:42px}.recipe h3{margin:10px 0 8px;font-size:22px}.meta{color:#7c7066;font-size:14px}.product-badge{display:inline-block;margin-top:12px;background:#fff0ed;color:var(--red);padding:7px 10px;border-radius:999px;font-size:13px;font-weight:900}.back{background:none;padding:0;color:#777}.recipe-title{font-size:36px;margin:10px 0}.lead{color:#655c55;line-height:1.7}.steps{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:22px 0}.step{background:var(--cream);padding:18px;border-radius:18px;border:1px solid #f0e0c7}.step b{display:block;color:var(--red);margin-bottom:7px}.shop{margin-top:28px;border-top:1px solid #eee;padding-top:22px}.shop h3{font-size:26px;margin:0 0 14px}.product{display:flex;align-items:center;gap:16px;padding:15px;border:1px solid #eee;border-radius:16px;margin:10px 0}.product img{width:70px;height:85px;object-fit:contain}.product-copy{flex:1}.product-copy b{font-size:18px}.product-copy p{margin:5px 0;color:#736860;font-size:14px}.buy{display:inline-block;background:var(--red);color:white;padding:10px 14px;border-radius:12px;text-decoration:none;font-weight:900}.buy.disabled{background:#aaa;pointer-events:none}footer{text-align:center;color:#948980;padding:30px}
